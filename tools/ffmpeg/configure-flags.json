[
  "--target-os=mingw32",
  "--arch=x86_64",
  "--cc=gcc",
  "--disable-autodetect",
  "--disable-network",
  "--disable-x86asm",
  "--disable-asm",
  "--disable-debug",
  "--disable-doc",
  "--disable-ffplay",
  "--disable-ffprobe",
  "--disable-shared",
  "--enable-static",
  "--disable-pthreads",
  "--enable-w32threads",
  "--disable-everything",
  "--disable-iconv",
  "--extra-ldflags=-static",
  "--enable-decoder=h264,hevc,vp9,mpeg4,bmp,gif,wrapped_avframe",
  "--enable-encoder=gif,bmp,mpeg4",
  "--enable-demuxer=mov,image2,image2pipe",
  "--enable-muxer=gif,image2,image2pipe,mov,mp4",
  "--enable-protocol=file,pipe",
  "--enable-filter=buffer,buffersink,palettegen,paletteuse,scale,format,testsrc2,null,split",
  "--enable-indev=lavfi",
  "--enable-parser=h264,hevc,vp9,mpeg4video"
]

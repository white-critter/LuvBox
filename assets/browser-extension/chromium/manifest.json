{
  "manifest_version": 3,
  "name": "LuvBox 브라우저 연결",
  "version": "1.2.0",
  "description": "사용자가 승인한 X 계정만 이 컴퓨터의 LuvBox에 연결합니다.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "permissions": ["cookies"],
  "host_permissions": ["https://x.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://x.com/*"], "js": ["profile.js"], "run_at": "document_idle"},
    {"matches": ["http://127.0.0.1/*"], "js": ["connect.js"], "run_at": "document_start"}
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "XlikeSaver 앱",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/entry.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "오프라인 테스트",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true
    }
  ]
}
